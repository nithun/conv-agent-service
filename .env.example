# Copy to .env for local dev (gitignored). Never commit real secrets.
#
# ENVIRONMENT: CR-009 (webhook auth) fail-closed gate — architecture-
# reviewer CONDITION 2 (BLOCKING). This field has NO baked default in code
# (app/config/settings.py). Only the EXACT string "local" opts a booting
# process into the published Glific dummy-signature-secret fallback for
# GLIFIC_WEBHOOK_SECRET below; ANY other value — including this line being
# absent/commented-out/typo'd — makes the app container FAIL TO BOOT if
# GLIFIC_WEBHOOK_SECRET is also unset, rather than silently "authenticating"
# a public webhook with a constant published in Glific's own open-source
# repo (lib/glific.ex:266-268, "This is a dummy secret"). Pre-filled here
# as "local" so a fresh `cp .env.example .env` still boots with zero
# further action — this is an explicit, affirmative local-dev opt-in, not a
# default the code falls back to on its own. MUST be changed to a
# non-"local" value (e.g. "staging"/"production", per AD-004's deployment
# topology) on any environment reachable from the public internet — and
# GLIFIC_WEBHOOK_SECRET below MUST then be set to a real, non-default
# secret, or the container will refuse to start (by design).
ENVIRONMENT=local

# GLIFIC_API_URL: local dev only - Glific runs on the HOST (not in Docker),
# reachable from inside a compose container at host.docker.internal, not
# localhost. This value is macOS/Darwin-specific Docker networking (see
# docs/architecture.md Sec5, docs/glific-dev-endpoint.md in the parent
# workspace) and must never be baked into code or staging/prod config.
GLIFIC_API_URL=http://host.docker.internal:4000

# FRAPPE_API_URL: remote HTTPS instance - URL pending from the user
# (Phase 0 task 0.5b). Leave empty until docs/frappe-dev-endpoint.md exists
# in the parent workspace; the Frappe client must fail loudly, not default
# to a guess, when this is unset.
#
# ADR-013 GL-005-b (CR-011, 2026-07-25): when ENVIRONMENT=production, the
# app now REFUSES TO BOOT unless this resolves to exactly lms.evalix.xyz
# (the evalix prod-restore, "feeds nothing back into live production" -
# F-043) - never a live-production TAP LMS, and never left unset either
# (unset does not count as "not production, skip the check"). This is a
# structural boot-time gate, not a deploy checklist item - see
# app/config/deploy_gates.py::resolve_lms_write_target_gate. Only fires
# when ENVIRONMENT is exactly "production"; any other environment value is
# unaffected.
FRAPPE_API_URL=

# REDIS_URL: compose sets this to redis://redis:6379 via docker-compose.yml
# `environment:` (service hostname on the compose network). Left here for
# reference / for running outside compose.
REDIS_URL=redis://redis:6379

# --- Populated once the user provisions these (WBS 0.3/0.4) ---
OPENROUTER_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# ADR-013 GL-005-a (CR-011, F-070, 2026-07-25): when ENVIRONMENT=production,
# the app now REFUSES TO BOOT unless this resolves to the compose-local
# self-hosted Langfuse instance (host in {langfuse, localhost, 127.0.0.1})
# - e.g. http://langfuse:3000 for a compose deployment. The baked default
# below (cloud.langfuse.com) would egress a real child's resolved identity
# + message text to external SaaS in production; this is a structural
# boot-time gate, not a deploy checklist item - see
# app/config/deploy_gates.py::resolve_langfuse_host_gate. Only fires when
# ENVIRONMENT is exactly "production"; any other environment value is
# unaffected (local dev keeps using this default or the self-hosted
# compose value freely).
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Glific auth (CR-004 port from tap-buddy) ---
# Dev defaults are the public seeded Glific dev-admin credentials (safe in
# .env.example per docs/glific-dev-endpoint.md - not a real secret).
GLIFIC_PHONE=917834811114
GLIFIC_PASSWORD=Secret1234!
# Optional relay-flow id (tap-buddy's GLIFIC_TURN_FLOW_ID equivalent) -
# which concrete flow this points at in production is glific-platform's
# F-019 cutover concern, out of this CR's scope.
GLIFIC_TURN_FLOW_ID=

# GLIFIC_HOST_HEADER_OVERRIDE: LOCAL-DEV-ONLY Docker workaround, empty by
# default - do NOT set this in staging/prod. The local dev Glific instance's
# SubdomainPlug hardcodes a hostname allowlist (localhost/127.0.0.1) that
# omits host.docker.internal, so it 403s any request whose Host header
# isn't in that allowlist - regardless of source IP or credentials (root
# cause: sibling glific-platform workspace's
# BR-001-docker-host-403-subdomain-plug.md; this workspace's diagnosis is
# ../docs/open-followups.md F-021, relative to this repo). Setting this to
# "localhost:4000" makes GlificClient send that literal value as the
# outbound Host header on every request while the TCP connection still
# goes to wherever GLIFIC_API_URL resolves (host.docker.internal:4000) -
# it bypasses the allowlist gap without touching the Glific repo. Leave
# empty/unset anywhere this workaround isn't needed (staging/prod, or once
# BR-001 is fixed on Glific's side).
GLIFIC_HOST_HEADER_OVERRIDE=

# --- TAP LMS / Frappe auth (CR-004 port from tap-buddy) ---
TAP_LMS_API_KEY=
# Required for get_next_content (allow_guest=False on the live server,
# live-verified 2026-07-03 - see tap-buddy/CLAUDE.md). Also required for
# start_quiz (F-028) and, since CR-011/ADR-013 (2026-07-27), the
# register_test_student/reset_test_student test-flow endpoints -- same
# credential, no new value needed. Never commit a real value.
TAP_LMS_TOKEN=

# --- Redis session store (R-2) ---
SESSION_TTL_SECONDS=1800

# --- Media (ASR/TTS voice notes, CR-004 port from tap-buddy) ---
PUBLIC_BASE_URL=http://localhost:8001
MEDIA_DIR=./data/media
MEDIA_TTL_SECONDS=86400

# GOOGLE_APPLICATION_CREDENTIALS: Google STT/TTS credential gate (BR-004
# Task 1, worker container only - app/config/settings.py's
# google_application_credentials field). docker-compose.yml's `worker`
# service already sets this automatically from GCP_SA_KEY_PATH below (the
# SAME variable the litellm service mounts) - no second key-path variable
# invented, and no value needs to be set here for a normal `docker compose
# up` run. This line only matters if the worker is ever run OUTSIDE compose
# (bare `python -m app.worker.main` against a locally-mounted key file) -
# leave empty otherwise. Empty/unset = no speech client is constructed
# (app/worker/main.py::_build_speech_client) and voice turns degrade
# gracefully (text-only), never crash the worker. Never bake a real value
# here - same local-dev-only-convenience framing as every other credential
# in this file.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Self-hosted Langfuse (docker-compose services: langfuse, langfuse-db) --
# Local-dev observability stack (F-020). Generate real values into .env with:
#   openssl rand -hex 32   (one each for the two secrets; any string for the db pw)
# LANGFUSE_HOST above should be http://langfuse:3000 for local compose runs
# (service-name URL on the compose network); the browser dashboard is
# http://localhost:3001. LANGFUSE_PUBLIC_KEY/SECRET_KEY come from the project
# you create in that dashboard.
LANGFUSE_DB_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# --- Glific webhook signature verification (CR-009) ------------------------
# Verifies Glific's own X-Glific-Signature header (HMAC-SHA256, keyed by the
# Glific organization's `signature_phrase`) on EVERY POST /webhook/glific
# request — there is no "off" mode.
#
# LOCAL DEV (F-047 correction, 2026-07-22): the standard seeded local dev
# Glific org is NOT unconfigured — its seeds set `signature_phrase` to the
# PUBLIC string pre-filled below (Glific OSS
# `priv/repo/seeds/20200723172939_add_glific_data.exs`, also
# `lib/glific/saas/queries.ex`; not a secret). The earlier "leave empty and
# the dummy-secret fallback matches" guidance was live-FALSE and 401'd
# every local webhook (see parent workspace's docs/open-followups.md
# F-047). The empty+ENVIRONMENT=local dummy fallback only matches an org
# whose `signature_phrase` was explicitly cleared — not the seeded default.
#
# STAGING/PROD: MUST be replaced with the EXACT value of the live org's
# `signature_phrase` (tap.glific.com's organization, for the GCP VM
# deployment) — delivered out-of-band only; NEVER paste that live value
# into any doc/commit in this repo, mirroring the global CLAUDE.md
# PAT-file-path convention. (The pre-filled value below is exempt from that
# rule solely because it is a published constant in Glific's open-source
# seed data.)
GLIFIC_WEBHOOK_SECRET="Please change me, NOW!"
# Body-size cap enforced before any HMAC computation. 64KB is generous for
# a WhatsApp text/media-URL JSON payload; rarely needs overriding.
MAX_WEBHOOK_BODY_BYTES=65536

# --- Contact allowlist (CR-010, F-042/F-043) --------------------------------
# Comma-separated Glific contact ids and/or phone numbers permitted to
# reach POST /webhook/glific — a request from any OTHER contact is
# rejected (403) before dedupe/distress-gate/enqueue, no reply/ticket/LLM
# call/Glific send from this service. FAIL-CLOSED: leaving this empty
# outside local dev makes the app container REFUSE TO BOOT (same
# discipline as GLIFIC_WEBHOOK_SECRET above) — there is no "off" mode.
#
# Format: "123,919876543210,456" — contact_id is the PREFERRED entry type
# (Glific's own stable internal id, immune to phone-formatting drift);
# a phone entry is matched EXACTLY as this service's webhook payload
# parser emits it (post `_N` simulator-suffix stripping) — no further
# normalization, no country-code guessing, so a phone entered in a
# different format than the live payload carries fails closed. A
# non-empty value here REPLACES the local-dev default below outright, in
# every environment including local — it never merges with it.
#
# LOCAL DEV DOUBLE-GATED FALLBACK (architecture-reviewer C-2, 2026-07-22):
# when this is left EMPTY, the app falls back to the known 5-contact
# Glific simulator pool (ids 2-6, glific-student-sim's fixed set) ONLY if
# BOTH ENVIRONMENT=local AND GLIFIC_API_URL looks local
# (localhost/127.0.0.1/host.docker.internal — the .env.example default
# above already qualifies). Any other combination — including
# ENVIRONMENT=local with a REAL, hosted GLIFIC_API_URL — fails closed with
# the same boot RuntimeError as any other unconfigured environment; ids
# 2-6 are local-seeded contacts, real people on any other Glific org.
#
# STAGING/PROD (tap-agent-vm): the operator's own dedicated F-057 test
# number is allowlist entry #1 (contact_id preferred, once its hosted
# Glific contact id is captured) — added one explicit token at a time as
# the trial cohort grows. NEVER a wildcard, NEVER derived by querying the
# LMS for "students in program X" (F-043: this allowlist, not the LMS's
# contents, is the exposure control). No real number is committed here.
GLIFIC_CONTACT_ALLOWLIST=

# --- Self-hosted LiteLLM gateway (compose service: litellm) — F-020 -------
# Open-source OpenAI-compatible proxy fronting Vertex AI (tap-buddy-mvp GCP
# creds) for LOCAL live verification without an OpenRouter account.
# To route the app through it: set OPENROUTER_BASE_URL=http://litellm:4000
# and OPENROUTER_API_KEY to the LITELLM_MASTER_KEY value. Leave
# OPENROUTER_BASE_URL empty to target real OpenRouter (default).
OPENROUTER_BASE_URL=
LITELLM_MASTER_KEY=
GCP_SA_KEY_PATH=
