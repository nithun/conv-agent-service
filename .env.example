# Copy to .env for local dev (gitignored). Never commit real secrets.
#
# GLIFIC_API_URL: local dev only - Glific runs on the HOST (not in Docker),
# reachable from inside a compose container at host.docker.internal, not
# localhost. This value is macOS/Darwin-specific Docker networking (see
# docs/architecture.md Sec5, docs/glific-dev-endpoint.md in the parent
# workspace) and must never be baked into code or staging/prod config.
GLIFIC_API_URL=http://host.docker.internal:4000

# FRAPPE_API_URL: remote HTTPS instance - URL pending from the user
# (Phase 0 task 0.5b). Leave empty until docs/frappe-dev-endpoint.md exists
# in the parent workspace; the Frappe client must fail loudly, not default
# to a guess, when this is unset.
FRAPPE_API_URL=

# REDIS_URL: compose sets this to redis://redis:6379 via docker-compose.yml
# `environment:` (service hostname on the compose network). Left here for
# reference / for running outside compose.
REDIS_URL=redis://redis:6379

# --- Populated once the user provisions these (WBS 0.3/0.4) ---
OPENROUTER_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Glific auth (CR-004 port from tap-buddy) ---
# Dev defaults are the public seeded Glific dev-admin credentials (safe in
# .env.example per docs/glific-dev-endpoint.md - not a real secret).
GLIFIC_PHONE=917834811114
GLIFIC_PASSWORD=Secret1234!
# Optional relay-flow id (tap-buddy's GLIFIC_TURN_FLOW_ID equivalent) -
# which concrete flow this points at in production is glific-platform's
# F-019 cutover concern, out of this CR's scope.
GLIFIC_TURN_FLOW_ID=

# GLIFIC_HOST_HEADER_OVERRIDE: LOCAL-DEV-ONLY Docker workaround, empty by
# default - do NOT set this in staging/prod. The local dev Glific instance's
# SubdomainPlug hardcodes a hostname allowlist (localhost/127.0.0.1) that
# omits host.docker.internal, so it 403s any request whose Host header
# isn't in that allowlist - regardless of source IP or credentials (root
# cause: sibling glific-platform workspace's
# BR-001-docker-host-403-subdomain-plug.md; this workspace's diagnosis is
# ../docs/open-followups.md F-021, relative to this repo). Setting this to
# "localhost:4000" makes GlificClient send that literal value as the
# outbound Host header on every request while the TCP connection still
# goes to wherever GLIFIC_API_URL resolves (host.docker.internal:4000) -
# it bypasses the allowlist gap without touching the Glific repo. Leave
# empty/unset anywhere this workaround isn't needed (staging/prod, or once
# BR-001 is fixed on Glific's side).
GLIFIC_HOST_HEADER_OVERRIDE=

# --- TAP LMS / Frappe auth (CR-004 port from tap-buddy) ---
TAP_LMS_API_KEY=
# Required for get_next_content (allow_guest=False on the live server,
# live-verified 2026-07-03 - see tap-buddy/CLAUDE.md). Never commit a real
# value.
TAP_LMS_TOKEN=

# --- Redis session store (R-2) ---
SESSION_TTL_SECONDS=1800

# --- Media (ASR/TTS voice notes, CR-004 port from tap-buddy) ---
PUBLIC_BASE_URL=http://localhost:8001
MEDIA_DIR=./data/media
MEDIA_TTL_SECONDS=86400

# --- Self-hosted Langfuse (docker-compose services: langfuse, langfuse-db) --
# Local-dev observability stack (F-020). Generate real values into .env with:
#   openssl rand -hex 32   (one each for the two secrets; any string for the db pw)
# LANGFUSE_HOST above should be http://langfuse:3000 for local compose runs
# (service-name URL on the compose network); the browser dashboard is
# http://localhost:3001. LANGFUSE_PUBLIC_KEY/SECRET_KEY come from the project
# you create in that dashboard.
LANGFUSE_DB_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# --- Self-hosted LiteLLM gateway (compose service: litellm) — F-020 -------
# Open-source OpenAI-compatible proxy fronting Vertex AI (tap-buddy-mvp GCP
# creds) for LOCAL live verification without an OpenRouter account.
# To route the app through it: set OPENROUTER_BASE_URL=http://litellm:4000
# and OPENROUTER_API_KEY to the LITELLM_MASTER_KEY value. Leave
# OPENROUTER_BASE_URL empty to target real OpenRouter (default).
OPENROUTER_BASE_URL=
LITELLM_MASTER_KEY=
GCP_SA_KEY_PATH=
